# -----------------------------------------------------------------------------
# StudiPod environment variables
# Copy to `.env` for local development. NEVER commit a real `.env` file.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put
# secrets in them.
# -----------------------------------------------------------------------------

# --- Site ---------------------------------------------------------------------
# Canonical public URL (used for metadata, sitemap and Origin checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) -----------------------------------------------------
# Runtime connection (may be a pooled connection string in production).
# Local default matches docker-compose.yml (local development only).
DATABASE_URL=postgresql://studipod:studipod_local_dev@localhost:5433/studipod?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Optional locally.
DIRECT_URL=
