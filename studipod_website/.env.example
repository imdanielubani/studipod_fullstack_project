# -----------------------------------------------------------------------------
# StudiPod environment variables
# Copy to `.env` for local development. NEVER commit a real `.env` file.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put
# secrets in them.
# -----------------------------------------------------------------------------

# --- Site ---------------------------------------------------------------------
# Canonical public URL (used for metadata, sitemap and Origin checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) -----------------------------------------------------
# Runtime connection (may be a pooled connection string in production).
# Local default matches docker-compose.yml (local development only).
DATABASE_URL=postgresql://studipod:studipod_local_dev@localhost:5433/studipod?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Optional locally.
DIRECT_URL=

# --- Bot protection (Cloudflare Turnstile) -----------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile — create a widget for your domain.
# Site key is public (rendered in the page). Leave both empty to disable locally.
# The SECRET key is server-only: never prefix it with NEXT_PUBLIC_.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Rate limiting: standard Redis (self-hosted, e.g. Dokploy on a VPS) -------
# Takes precedence over Upstash when set. Use redis:// on a private network or
# rediss:// for TLS. Always use a password; never expose Redis to the internet.
# Local docker-compose value: redis://:studipod_local_dev@localhost:6380
REDIS_URL=

# --- Distributed rate limiting (Upstash Redis) --------------------------------
# Required in production (serverless/multi-instance). Without these, a per-instance
# in-memory limiter is used, which is only suitable for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public links (optional) ---------------------------------------------------
# Footer links. When empty, the footer shows a labelled "Soon" placeholder
# instead of a dead link. Only http(s) URLs and valid emails are accepted.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Defaults to hello@studipod.com when empty.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FAQ_URL=
