// StudiPod database schema.
// Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts (runtime),
// both read from environment variables — never from this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a waitlist registration.
enum WaitlistStatus {
  PENDING
  INVITED
  JOINED
  UNSUBSCRIBED

  @@map("waitlist_status")
}

/// Early-access waitlist registration.
/// Stores only what is needed to contact the person about early access —
/// no IP addresses, user agents or tracking data.
model WaitlistEntry {
  id                  String         @id @default(uuid(7)) @db.Uuid
  fullName            String         @map("full_name") @db.VarChar(100)
  /// Normalised (trimmed, lower-cased) address. Uniqueness prevents duplicates.
  email               String         @unique(map: "waitlist_entries_email_key") @db.VarChar(254)
  examinationCategory String?        @map("examination_category") @db.VarChar(100)
  status              WaitlistStatus @default(PENDING)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "waitlist_entries_status_created_at_idx")
  @@index([createdAt], map: "waitlist_entries_created_at_idx")
  @@map("waitlist_entries")
}

/// One successfully sent waitlist digest email. The next digest covers
/// registrations created after the latest `periodEnd`. Holds counts and
/// timestamps only — no personal data.
model WaitlistDigestRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Exclusive lower bound (null for the very first digest).
  periodStart DateTime? @map("period_start") @db.Timestamptz(3)
  /// Inclusive upper bound.
  periodEnd   DateTime  @map("period_end") @db.Timestamptz(3)
  entryCount  Int       @map("entry_count")
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@index([periodEnd], map: "waitlist_digest_runs_period_end_idx")
  @@map("waitlist_digest_runs")
}
