{
  "name": "@studipod/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Studipod backend: REST API, WebSocket gateway and background workers.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests --selectProjects unit",
    "test:integration": "jest --passWithNoTests --selectProjects integration",
    "test:e2e": "jest --passWithNoTests --selectProjects e2e",
    "test:cov": "jest --passWithNoTests --coverage",
    "test:load:artillery": "artillery run",
    "test:load:k6": "k6 run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.12",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-fastify": "12.6.0",
    "@nestjs/platform-socket.io": "12.6.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/websockets": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.2",
    "bullmq": "6.7.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "firebase-admin": "14.5.1",
    "ioredis": "6.0.0",
    "livekit-server-sdk": "2.20.1",
    "nestjs-pino": "5.3.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.39.0",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "stripe": "23.2.0",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "artillery": "2.0.34",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
