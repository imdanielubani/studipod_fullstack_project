# Production template. DO NOT create a .env file on the server from this.
# Enter each value in Dokploy (Project > Environment) so secrets stay out of the
# image, the repository and shell history. Staging uses the same keys with its
# own, separate values (separate database, Redis, buckets, Stripe test mode).
#
# Every <...> value must be replaced. Every secret must be unique per environment.

NODE_ENV=production
# Public hostnames used by the Traefik routers in the Dokploy compose file.
API_DOMAIN=api.<your-domain>
WS_DOMAIN=ws.<your-domain>
APP_ENV=production
HOST=0.0.0.0
PORT=3000
WS_PORT=3001
API_PREFIX=api
API_VERSION=1
APP_PUBLIC_URL=https://api.<your-domain>
WEBAPP_URL=https://app.<your-domain>
ADMIN_DASHBOARD_URL=https://admin.<your-domain>
CORS_ALLOWED_ORIGINS=https://app.<your-domain>,https://admin.<your-domain>
# Cloudflare + Traefik = 2 trusted hops.
TRUST_PROXY_HOPS=2
LOG_LEVEL=info
SWAGGER_ENABLED=false

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Containers on the private Docker network only. The studipod-* hostnames are network
# aliases, unique so they cannot collide with other stacks on the shared Dokploy network.
POSTGRES_USER=studipod
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=studipod
# Application traffic goes through PgBouncer (transaction pooling).
DATABASE_URL=postgresql://studipod:<generated>@studipod-pgbouncer:6432/studipod?schema=public
# Migrations connect to PostgreSQL directly.
DIRECT_DATABASE_URL=postgresql://studipod:<generated>@studipod-postgres:5432/studipod?schema=public
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_PASSWORD=<generated>
REDIS_URL=redis://:<generated>@studipod-valkey:6379/0
REDIS_KEY_PREFIX=studipod:
BULLMQ_PREFIX=studipod:queue

JWT_ISSUER=studipod-api
JWT_CANDIDATE_AUDIENCE=studipod-webapp
JWT_ACCESS_SECRET=<generated>
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=<generated>
JWT_REFRESH_TTL=30d
JWT_ADMIN_AUDIENCE=studipod-admin
JWT_ADMIN_ACCESS_SECRET=<generated>
JWT_ADMIN_ACCESS_TTL=10m
JWT_ADMIN_REFRESH_SECRET=<generated>
JWT_ADMIN_REFRESH_TTL=12h
COOKIE_SECRET=<generated>

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-token-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-token-secret>
R2_ENDPOINT=
R2_PRIVATE_BUCKET=studipod-prod-private
R2_PUBLIC_BUCKET=studipod-prod-public
R2_PUBLIC_BASE_URL=https://cdn.<your-domain>
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>

RESEND_API_KEY=<re_...>
RESEND_WEBHOOK_SECRET=<whsec_...>
EMAIL_FROM=Studipod <no-reply@<your-domain>>
EMAIL_REPLY_TO=support@<your-domain>

LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
LIVEKIT_TOKEN_TTL_SECONDS=3600

VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:support@<your-domain>

FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<service-account-email>
FIREBASE_PRIVATE_KEY=<service-account-private-key-with-literal-backslash-n>
