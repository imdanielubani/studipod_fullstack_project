# Local development template. Copy to .env and adjust:
#   cp .env.development.example .env
#
# Values match docker-compose.yml. Every variable is described in .env.example.
# Third-party keys stay empty until you need that integration; use test-mode keys only.

NODE_ENV=development
APP_ENV=development
HOST=0.0.0.0
PORT=3000
WS_PORT=3001
API_PREFIX=api
API_VERSION=1
APP_PUBLIC_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3100
ADMIN_DASHBOARD_URL=http://localhost:3200
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug
SWAGGER_ENABLED=true

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=50

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Host ports for docker-compose.yml. Change them (and the URLs below) if a local
# PostgreSQL or Redis already uses 5432 / 6379.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PGBOUNCER_HOST_PORT=6432

POSTGRES_USER=studipod
POSTGRES_PASSWORD=studipod_local_only
POSTGRES_DB=studipod
DATABASE_URL=postgresql://studipod:studipod_local_only@localhost:5432/studipod?schema=public
DIRECT_DATABASE_URL=postgresql://studipod:studipod_local_only@localhost:5432/studipod?schema=public
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_PASSWORD=studipod_local_only
REDIS_URL=redis://:studipod_local_only@localhost:6379/0
REDIS_KEY_PREFIX=studipod:
BULLMQ_PREFIX=studipod:queue

JWT_ISSUER=studipod-api
JWT_CANDIDATE_AUDIENCE=studipod-webapp
JWT_ACCESS_SECRET=change-me-run-generate-secrets
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-run-generate-secrets
JWT_REFRESH_TTL=30d
JWT_ADMIN_AUDIENCE=studipod-admin
JWT_ADMIN_ACCESS_SECRET=change-me-run-generate-secrets
JWT_ADMIN_ACCESS_TTL=10m
JWT_ADMIN_REFRESH_SECRET=change-me-run-generate-secrets
JWT_ADMIN_REFRESH_TTL=12h
COOKIE_SECRET=change-me-run-generate-secrets

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PRIVATE_BUCKET=studipod-dev-private
R2_PUBLIC_BUCKET=studipod-dev-public
R2_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Studipod <no-reply@example.com>
EMAIL_REPLY_TO=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
