# =============================================================================
# Studipod backend: environment variable reference
# =============================================================================
# Placeholders only. Never put real credentials in this file or in Git.
#
#   Local development: copy .env.development.example to .env
#   Staging/production: set variables in Dokploy (see .env.production.example)
#
# Generate secrets with:  infrastructure/scripts/generate-secrets.sh
# Full documentation:     docs/deployment/environment-variables.md
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production
APP_ENV=development
HOST=0.0.0.0
PORT=3000
WS_PORT=3001
API_PREFIX=api
API_VERSION=1
APP_PUBLIC_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3100
ADMIN_DASHBOARD_URL=http://localhost:3200
# Comma-separated exact origins. Never use * in staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200
# Number of trusted reverse-proxy hops. 0 locally; 2 behind Cloudflare + Traefik.
# Never trust all hops: a client could then spoof its IP via X-Forwarded-For.
TRUST_PROXY_HOPS=0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# OpenAPI UI. Keep false in production unless protected.
SWAGGER_ENABLED=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# --- Password hashing (Argon2id) ---------------------------------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- PostgreSQL --------------------------------------------------------------
# Container bootstrap values (docker-compose only).
POSTGRES_USER=studipod
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studipod
# Runtime connection used by the application (PgBouncer in production).
DATABASE_URL=postgresql://studipod:change-me@localhost:5432/studipod?schema=public
# Direct connection used by Prisma Migrate (never through PgBouncer).
DIRECT_DATABASE_URL=postgresql://studipod:change-me@localhost:5432/studipod?schema=public
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis / Valkey ----------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_KEY_PREFIX=studipod:
BULLMQ_PREFIX=studipod:queue

# --- JWT (candidate webapp) --------------------------------------------------
JWT_ISSUER=studipod-api
JWT_CANDIDATE_AUDIENCE=studipod-webapp
JWT_ACCESS_SECRET=change-me-min-64-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-min-64-random-chars
JWT_REFRESH_TTL=30d

# --- JWT (admin dashboard): separate secrets from candidate tokens -----------
JWT_ADMIN_AUDIENCE=studipod-admin
JWT_ADMIN_ACCESS_SECRET=change-me-min-64-random-chars
JWT_ADMIN_ACCESS_TTL=10m
JWT_ADMIN_REFRESH_SECRET=change-me-min-64-random-chars
JWT_ADMIN_REFRESH_TTL=12h

# Signs refresh-token cookies.
COOKIE_SECRET=change-me-min-64-random-chars

# --- Cloudflare R2 (S3-compatible object storage) ----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; derived from R2_ACCOUNT_ID when empty.
R2_ENDPOINT=
# Private bucket: uploads, attachments (signed URLs only).
R2_PRIVATE_BUCKET=studipod-dev-private
# Public bucket: avatars and public resources (served through a Cloudflare custom domain).
R2_PUBLIC_BUCKET=studipod-dev-public
R2_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# --- Stripe ------------------------------------------------------------------
# Use test-mode keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Studipod <no-reply@example.com>
EMAIL_REPLY_TO=

# --- LiveKit Cloud (video) ---------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600

# --- Web Push (VAPID) --------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Firebase Cloud Messaging ------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n sequences.
FIREBASE_PRIVATE_KEY=
