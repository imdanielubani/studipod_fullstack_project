{
  "name": "studipod",
  "version": "0.0.0",
  "private": true,
  "description": "Studipod monorepo: backend services, candidate webapp and admin dashboard.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "backend": "pnpm --filter @studipod/backend",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
