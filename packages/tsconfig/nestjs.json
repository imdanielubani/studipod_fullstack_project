{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Studipod NestJS service",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "removeComments": true,
    "types": ["node", "jest"]
  }
}
