# Studipod Admin Dashboard: environment variable reference.
#
# Copy to .env.local for local development (never commit it):
#   cp .env.development.example .env.local
#
# SECURITY: every NEXT_PUBLIC_* value is inlined into the JavaScript sent to the
# browser at BUILD time. Never put secrets, API keys or tokens in this file.
# The dashboard holds no backend secrets; they belong to studipod-backend.
# See docs/deployment/environment-variables.md.

# Public origin of this dashboard (no trailing slash).
NEXT_PUBLIC_APP_URL=

# Base URL of the Studipod REST API including the version prefix (no trailing slash),
# e.g. https://api.example.com/api/v1. Admin routes live under /admin on this base.
NEXT_PUBLIC_API_URL=

# Socket.IO endpoint of the Studipod WebSocket gateway (ws:// or wss://).
NEXT_PUBLIC_WS_URL=

# Optional: candidate web app URL, linked from the "Access denied" screen for
# candidate accounts. The link is hidden when unset.
NEXT_PUBLIC_WEBAPP_URL=

# Optional: mailbox that reaches the Super Admins, used by "Contact a Super Admin"
# links on the sign-in screens. The links are hidden when unset.
NEXT_PUBLIC_ADMIN_SUPPORT_EMAIL=

# Optional: help centre for administrators, linked from the account menu.
# The menu item is hidden when unset.
NEXT_PUBLIC_ADMIN_HELP_URL=

# Development only: "true" replaces the authentication API with an in-memory mock
# (see docs/api/admin-authentication-contract.md). Ignored by production builds.
NEXT_PUBLIC_AUTH_MOCK=false

# Server-only runtime settings (not inlined into the browser bundle).
# Port the Next.js server listens on inside the container.
PORT=3000
# Interface the standalone server binds to; 0.0.0.0 inside Docker.
HOSTNAME=0.0.0.0
# Disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
