{
  "name": "@studipod/admin-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Studipod Admin Dashboard: internal administration console for the Studipod platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:list": "playwright test --list --pass-with-no-tests",
    "test:e2e:install": "playwright install --with-deps chromium",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-is": "19.3.1",
    "recharts": "3.11.1",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
