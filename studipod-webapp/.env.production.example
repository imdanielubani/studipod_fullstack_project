# Production values. In Dokploy, set the NEXT_PUBLIC_* keys as BUILD ARGUMENTS
# (they are inlined at build time) and the remaining keys as environment variables.
# Changing a NEXT_PUBLIC_* value requires a rebuild, not just a restart.
# Replace the LiveKit placeholder with the production LiveKit Cloud project URL.

NEXT_PUBLIC_APP_URL=https://app.studipod.com
NEXT_PUBLIC_API_URL=https://api.studipod.com/api/v1
NEXT_PUBLIC_WS_URL=wss://ws.studipod.com
NEXT_PUBLIC_LIVEKIT_URL=wss://your-production-project.livekit.cloud

PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
