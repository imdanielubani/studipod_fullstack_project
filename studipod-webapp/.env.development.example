# Local development defaults. Copy to .env.local:
#   cp .env.development.example .env.local
# Ports match the studipod-backend local setup (API 3000, WebSocket gateway 3001,
# webapp 3100). Use a LiveKit Cloud development project URL for video work.

NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_LIVEKIT_URL=wss://your-dev-project.livekit.cloud

NEXT_TELEMETRY_DISABLED=1
