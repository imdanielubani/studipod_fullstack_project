# Studipod Candidate Webapp: environment variable reference.
#
# Copy to .env.local for local development (never commit it):
#   cp .env.development.example .env.local
#
# SECURITY: every NEXT_PUBLIC_* value is inlined into the JavaScript sent to the browser
# at BUILD time. Never put secrets, API keys, LiveKit API secrets, Stripe secret keys or
# tokens in this file. The webapp holds no backend secrets; they belong to studipod-backend.
# See docs/deployment/environment-variables.md.

# Public origin of this webapp (no trailing slash).
NEXT_PUBLIC_APP_URL=

# Base URL of the Studipod REST API including the version prefix (no trailing slash),
# e.g. https://api.example.com/api/v1.
NEXT_PUBLIC_API_URL=

# Socket.IO endpoint of the Studipod WebSocket gateway (ws:// or wss://).
NEXT_PUBLIC_WS_URL=

# LiveKit Cloud project URL (wss://). Public by design: participant access tokens are
# issued per session by the backend, never created in the webapp.
NEXT_PUBLIC_LIVEKIT_URL=

# Server-only runtime settings (not inlined into the browser bundle).
# Port the Next.js server listens on inside the container.
PORT=3000
# Interface the standalone server binds to; 0.0.0.0 inside Docker.
HOSTNAME=0.0.0.0
# Disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
