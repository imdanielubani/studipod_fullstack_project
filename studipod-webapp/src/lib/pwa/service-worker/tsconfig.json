{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "webworker"],
    "types": ["@serwist/next/typings"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./*.ts"]
}
