{
  "name": "@studipod/webapp",
  "version": "0.0.0",
  "private": true,
  "description": "Studipod Candidate Webapp: installable Progressive Web App for examination candidates.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "start:standalone": "node infrastructure/scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/lib/pwa/service-worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:list": "playwright test --list --pass-with-no-tests",
    "test:e2e:install": "playwright install --with-deps chromium",
    "api:generate": "node infrastructure/scripts/generate-api-types.mjs",
    "icons:generate": "node infrastructure/scripts/generate-icons.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@livekit/components-react": "2.9.26",
    "@livekit/components-styles": "1.2.0",
    "@serwist/next": "9.5.15",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "livekit-client": "2.25.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "next-intl": "4.16.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "serwist": "9.5.15",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@serwist/cli": "9.5.15",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
